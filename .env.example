# Google Places API Key für automatische Rating-Updates
# Erstelle den Key hier: https://console.cloud.google.com/apis/credentials?project=openclaw-myhb
GOOGLE_PLACES_API_KEY=your-google-places-api-key-here

# Strapi Content API Token — nur für lokale Scripts (npm run generate:posters).
# Anlegen in Strapi: Settings → API Tokens → Create new API Token.
# Rechte minimal halten: Read-only genügt.
# NIEMALS committen — diese Datei ist nur ein Muster, echte Werte gehören in .env
STRAPI_API_TOKEN=your-strapi-api-token-here
